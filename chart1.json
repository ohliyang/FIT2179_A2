{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1080,
  "height": 750,
  "config": {
    "view": {
      "stroke": null
    }
  },
  "projection": {
    "type": "mercator"
  },
  "background": "#d6e6fc",
  "params": [
    {
      "name": "showCount",
      "value": true,
      "bind": {
        "input": "checkbox",
        "name": "Show Participants"
      }
    },
    {
      "name": "showAnnotation",
      "value": true,
      "bind": {
        "input": "checkbox",
        "name": "Show Annotations"
      }
    },
    {
      "name": "bubbleScale",
      "value": 3000,
      "bind": {
        "input": "range",
        "min": 500,
        "max": 30000,
        "step": 100,
        "name": "Bubble Size "
      }
    }
  ],
  "datasets": {
    "annotations": [
      {
        "state": "VIC",
        "x1": 126.4,
        "x2": 139.2,
        "y1": -40,
        "y2": -42.1
      },
      {
        "state": "NSW",
        "x1": 154.5,
        "x2": 162.8,
        "y1": -26.9,
        "y2": -30.2
      },
      {
        "state": "ACT",
        "x1": 153.7,
        "x2": 161,
        "y1": -34,
        "y2": -37.2
      }
    ]
  },
  "layer": [
    {
      "data": {
        "url": "STE_2016_AUST.json",
        "format": {
          "type": "topojson",
          "feature": "australia"
        }
      },
      "transform": [
        {
          "lookup": "properties.STE_NAME16",
          "from": {
            "data": {
              "url": "chart1_map_data1.csv"
            },
            "key": "State",
            "fields": [
              "Participation Rate",
              "Estimate",
              "State Population"
            ]
          }
        }
      ],
      "params": [
        {
          "name": "hoverState",
          "select": {
            "type": "point",
            "fields": [
              "properties.STE_NAME16"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white"
      },
      "encoding": {
        "color": {
          "field": "Participation Rate",
          "type": "quantitative",
          "scale": {
            "scheme": "blues"
          },
          "title": "Participation Rate (%)"
        },
        "opacity": {
          "condition": {
            "param": "hoverState",
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "properties.STE_NAME16",
            "title": "State"
          },
          {
            "field": "Participation Rate",
            "title": "Participation Rate (%)"
          },
          {
            "field": "Estimate",
            "title": "Participants"
          },
          {
            "field": "State Population",
            "title": "State Population",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "chart1_map_data1.csv"
      },
      "mark": {
        "type": "circle",
        "color": "#ffab0e",
        "opacity": 0.8,
        "stroke": "black",
        "strokeWidth": 0.5,
        "tooltip": {
          "content": "data"
        }
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "Estimate",
          "type": "quantitative",
          "title": "Participant Count",
          "scale": {
            "range": [
              50,
              {
                "expr": "bubbleScale"
              }
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "showCount",
            "value": 0.8
          },
          "value": 0
        },
        "text": {
          "condition": {
            "param": "showCount",
            "field": "Estimate"
          }
        }
      }
    },
    {
      "data": {
        "url": "chart1_map_data1.csv"
      },
      "mark": {
        "type": "text",
        "dy": 0,
        "dx": 45,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "State Symbol"
        }
      }
    },
    {
      "data": {
        "url": "chart1_map_data1.csv"
      },
      "transform": [
        {
          "calculate": "datum['Participation Rate'] + '%'",
          "as": "ParticipationLabel"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 15,
        "dx": 47,
        "fontSize": 12,
        "color": "black"
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "text": {
          "field": "ParticipationLabel"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "State Symbol": "WA",
            "lon": 122,
            "lat": -25,
            "Estimate": 35000,
            "dx": 0,
            "dy": 0
          },
          {
            "State Symbol": "NT",
            "lon": 133,
            "lat": -18,
            "Estimate": 4000,
            "dx": 0,
            "dy": -18
          },
          {
            "State Symbol": "SA",
            "lon": 136,
            "lat": -29,
            "Estimate": 18000,
            "dx": 0,
            "dy": 18
          },
          {
            "State Symbol": "QLD",
            "lon": 145,
            "lat": -22,
            "Estimate": 72000,
            "dx": 0,
            "dy": 0
          },
          {
            "State Symbol": "NSW",
            "lon": 147,
            "lat": -32,
            "Estimate": 138000,
            "dx": 0,
            "dy": 0
          },
          {
            "State Symbol": "ACT",
            "lon": 149,
            "lat": -34.7,
            "Estimate": 8000,
            "dx": 0,
            "dy": -18
          },
          {
            "State Symbol": "VIC",
            "lon": 145,
            "lat": -37,
            "Estimate": 125000,
            "dx": 0,
            "dy": 0
          },
          {
            "State Symbol": "TAS",
            "lon": 146.6,
            "lat": -42.7,
            "Estimate": 6000,
            "dx": 0,
            "dy": 18
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "black"
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "text": {
          "field": "Estimate",
          "format": ","
        },
        "opacity": {
          "condition": {
            "param": "showCount",
            "value": 0.8
          },
          "value": 0
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
            "lon": 150,
            "lat": -30,
            "labelLon": 154.5,
            "labelLat": -29
          },
          {
            "state": "VIC",
            "lon": 142,
            "lat": -37,
            "labelLon": 139.2,
            "labelLat": -41
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "black",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "longitude2": {
          "field": "labelLon"
        },
        "latitude2": {
          "field": "labelLat"
        },
        "opacity": {
          "condition": {
            "param": "showAnnotation",
            "value": 0.8
          },
          "value": 0
        }
      }
    },
    {
      "data": {
        "name": "annotations"
      },
      "mark": {
        "type": "rect",
        "fill": "#ffffff",
        "stroke": "black",
        "strokeWidth": 1.5,
        "cornerRadius": 6
      },
      "encoding": {
        "longitude": {
          "field": "x1"
        },
        "longitude2": {
          "field": "x2"
        },
        "latitude": {
          "field": "y1"
        },
        "latitude2": {
          "field": "y2"
        },
        "opacity": {
          "condition": {
            "param": "showAnnotation",
            "value": 0.8
          },
          "value": 0
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "text": [
              "ACT has the highest",
              "participation rate at",
              "2.5% despite small",
              "population"
            ],
            "x": 153,
            "y": -35.5
          },
          {
            "text": [
              "NSW has largest",
              "badminton community",
              "with nearly 138,000",
              "participants"
            ],
            "x": 154,
            "y": -28.5
          },
          {
            "text": [
              "VIC has strong participation rate",
              "and second-largest participant base"
            ],
            "x": 126,
            "y": -41.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "align": "left",
        "dx": 20,
        "dy": -20,
        "color": "black"
      },
      "encoding": {
        "longitude": {
          "field": "x"
        },
        "latitude": {
          "field": "y"
        },
        "text": {
          "field": "text"
        },
        "opacity": {
          "condition": {
            "param": "showAnnotation",
            "value": 0.8
          },
          "value": 0
        }
      }
    }
  ]
}