{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#e7f5e7",
  "width": 445,
  "height": 165,
  "data": {
    "url": "chart6_heat_map.csv"
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2023,
        "max": 2024,
        "step": 1,
        "name": "2023"
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.Year == selectedYear"
    },
    {
      "calculate": "toNumber(replace(datum['Participation Rate'], '%',''))",
      "as": "rate"
    },
    {
      "calculate": "'In ' + datum.Year + ', ' + format(datum.rate, '.1f') + '% participation are ' + datum.Gender + ' aged ' + datum['Age group']",
      "as": "tooltip_text"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "hoverCell",
          "select": {
            "type": "point",
            "fields": [
              "Gender",
              "Age group"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "Gender",
          "type": "nominal",
          "sort": [
            "Male",
            "Female",
            "All"
          ],
          "title": null,
          "axis": {
            "orient": "top",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Age group",
          "type": "ordinal",
          "title": "Age Group"
        },
        "color": {
          "field": "rate",
          "type": "quantitative",
          "title": "Participation (%)",
          "scale": {
            "scheme": "blues"
          }
        },
        "opacity": {
          "condition": {
            "param": "hoverCell",
            "value": 1
          },
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "tooltip_text",
            "type": "nominal",
            "title": "Insight"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "Gender",
          "type": "nominal",
          "sort": [
            "Male",
            "Female",
            "All"
          ]
        },
        "y": {
          "field": "Age group",
          "type": "ordinal"
        },
        "text": {
          "field": "Participation Rate"
        },
        "color": {
          "condition": {
            "test": "datum.rate > 4",
            "value": "white"
          },
          "value": "black"
        },
        "opacity": {
          "condition": {
            "param": "hoverCell",
            "value": 1
          },
          "value": 0.3
        }
      }
    }
  ],
  "config": {
    "axis": {
      "grid": true,
      "tickBand": "extent"
    }
  }
}