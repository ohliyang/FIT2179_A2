{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 365,
    "height": 220,
    "background": "#e7f5e7",
    "data": {
        "url": "chart9_dumbbell_chart.csv"
    },
    "params": [
        {
            "name": "sortBy",
            "value": "change",
            "bind": {
                "input": "select",
                "name": "Sort By: ",
                "options": [
                    "change",
                    "increase",
                    "decrease",
                    "2024",
                    "2023"
                ],
                "labels": [
                    "Largest Change",
                    "Largest Increase",
                    "Largest Decrease",
                    "2024 Rate",
                    "2023 Rate"
                ]
            }
        }
    ],
    "transform": [
        {
            "calculate": "toNumber(replace(datum['Participation Rate'], '%',''))",
            "as": "rate"
        },
        {
            "pivot": "Year",
            "value": "rate",
            "groupby": [
                "Employment"
            ]
        },
        {
            "calculate": "abs(datum['2024'] - datum['2023'])",
            "as": "change"
        },
        {
            "calculate": "datum['2024'] - datum['2023']",
            "as": "increase"
        },
        {
            "calculate": "datum['2023'] - datum['2024']",
            "as": "decrease"
        },
        {
            "calculate": "min(datum['2023'], datum['2024'])",
            "as": "min_rate"
        },
        {
            "calculate": "max(datum['2023'], datum['2024'])",
            "as": "max_rate"
        },
        {
            "calculate": "sortBy === '2023' ? datum['2023'] : sortBy === '2024' ? datum['2024'] : sortBy === 'increase' ? datum.increase : sortBy === 'decrease' ? datum.decrease : datum.change",
            "as": "sort_value"
        },
        {
            "fold": [
                "2023",
                "2024"
            ],
            "as": [
                "Year",
                "rate"
            ]
        }
    ],
    "encoding": {
        "y": {
            "field": "Employment",
            "type": "nominal",
            "sort": {
                "field": "sort_value",
                "order": "descending"
            },
            "title": "Employment"
        }
    },
    "layer": [
        {
            "params": [
                {
                    "name": "hover",
                    "select": {
                        "type": "point",
                        "fields": [
                            "Employment"
                        ],
                        "on": "mouseover",
                        "clear": "mouseout"
                    }
                }
            ],
            "mark": {
                "type": "trail",
                "opacity": 0.85,
                "color": "gray"
            },
            "encoding": {
                "x": {
                    "field": "rate",
                    "type": "quantitative",
                    "title": "Participation Rate (%)",
                    "scale": {
                        "domain": [
                            0,
                            2.4
                        ]
                    },
                    "axis": {
                        "grid": false
                    }
                },
                "detail": {
                    "field": "Employment"
                },
                "size": {
                    "condition": {
                        "param": "hover",
                        "empty": false,
                        "value": 4
                    },
                    "value": 2
                },
                "opacity": {
                    "condition": {
                        "param": "hover",
                        "value": 1
                    },
                    "value": 0.25
                }
            }
        },
        {
            "params": [
                {
                    "name": "hover1",
                    "select": {
                        "type": "point",
                        "fields": [
                            "Employment"
                        ],
                        "on": "mouseover",
                        "clear": "mouseout"
                    }
                }
            ],
            "mark": {
                "type": "point",
                "filled": true,
                "size": 70
            },
            "encoding": {
                "x": {
                    "field": "rate",
                    "type": "quantitative"
                },
                "color": {
                    "field": "Year",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "2023",
                            "2024"
                        ],
                        "range": [
                            "#4e79a7",
                            "#e15759"
                        ]
                    },
                    "legend": {
                        "title": "Year",
                        "orient": "right"
                    }
                },
                "size": {
                    "condition": {
                        "param": "hover1",
                        "empty": false,
                        "value": 120
                    },
                    "value": 70
                },
                "opacity": {
                    "condition": {
                        "param": "hover1",
                        "value": 1
                    },
                    "value": 0.25
                },
                "tooltip": [
                    {
                        "field": "Employment",
                        "type": "nominal"
                    },
                    {
                        "field": "Year",
                        "type": "ordinal"
                    },
                    {
                        "field": "rate",
                        "type": "quantitative",
                        "format": ".2f",
                        "title": "Participation Rate (%)"
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.rate == datum.min_rate"
                }
            ],
            "params": [
                {
                    "name": "hover2",
                    "select": {
                        "type": "point",
                        "fields": [
                            "Employment"
                        ],
                        "on": "mouseover",
                        "clear": "mouseout"
                    }
                }
            ],
            "mark": {
                "type": "text",
                "align": "right",
                "dx": -7,
                "dy": 1,
                "baseline": "middle",
                "fontSize": 11
            },
            "encoding": {
                "x": {
                    "field": "rate",
                    "type": "quantitative"
                },
                "text": {
                    "field": "rate",
                    "format": ".1f"
                },
                "color": {
                    "field": "Year",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "2023",
                            "2024"
                        ],
                        "range": [
                            "#4e79a7",
                            "#e15759"
                        ]
                    },
                    "legend": null
                },
                "size": {
                    "condition": {
                        "param": "hover2",
                        "empty": false,
                        "value": 14
                    },
                    "value": 11
                },
                "opacity": {
                    "condition": {
                        "param": "hover2",
                        "value": 1
                    },
                    "value": 0.25
                }
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.rate == datum.max_rate"
                }
            ],
            "params": [
                {
                    "name": "hover3",
                    "select": {
                        "type": "point",
                        "fields": [
                            "Employment"
                        ],
                        "on": "mouseover",
                        "clear": "mouseout"
                    }
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 7,
                "dy": 1,
                "baseline": "middle",
                "fontSize": 11,
                "fontWeight": "bold"
            },
            "encoding": {
                "x": {
                    "field": "rate",
                    "type": "quantitative"
                },
                "text": {
                    "field": "rate",
                    "format": ".1f"
                },
                "color": {
                    "field": "Year",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "2023",
                            "2024"
                        ],
                        "range": [
                            "#4e79a7",
                            "#e15759"
                        ]
                    },
                    "legend": null
                },
                "size": {
                    "condition": {
                        "param": "hover3",
                        "empty": false,
                        "value": 14
                    },
                    "value": 11
                },
                "opacity": {
                    "condition": {
                        "param": "hover3",
                        "value": 1
                    },
                    "value": 0.25
                }
            }
        },
        {
            "data": {
                "values": [
                    {}
                ]
            },
            "mark": {
                "type": "rect",
                "fill": "#ffffff",
                "stroke": "#999",
                "cornerRadius": 4
            },
            "encoding": {
                "x": {
                    "value": 330
                },
                "x2": {
                    "value": 475
                },
                "y": {
                    "value": 100
                },
                "y2": {
                    "value": 175
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "text": [
                            "Full-time students were excluded",
                            "from the chart due to their",
                            "substantially higher participation",
                            "rate (8.7%) and no change across",
                            "years, which would compress",
                            "variation among other groups."
                        ]
                    }
                ]
            },
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "top",
                "fontSize": 9,
                "fill": "black"
            },
            "encoding": {
                "x": {
                    "value": 334
                },
                "y": {
                    "value": 105
                },
                "text": {
                    "field": "text"
                }
            }
        }
    ]
}